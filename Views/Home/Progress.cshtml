@model ExcelAiCategorizer.Models.CategorizationJob
@{
    ViewData["Title"] = "Tahlil jarayoni";
}

<div class="row justify-content-center">
    <div class="col-lg-8" data-job-id="@Model.Id" id="job">

        <div class="hero anim-in" style="padding-top:0.5rem;">
            <span class="hero-badge">
                <span class="dot"></span>
                Jonli jarayon
            </span>
            <h1 style="font-size:clamp(1.5rem,3.5vw,2.1rem);">Tahlil jarayoni</h1>
            <p class="lead">Fayl: <strong>@Model.FileName</strong></p>
        </div>

        <div class="card is-glow mb-4 anim-in d1">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span id="status-label" class="badge bg-secondary">Kutilmoqda</span>
                    <span id="counter" class="small text-muted fw-semibold">0 / 0 qator</span>
                </div>

                <div class="progress">
                    <div id="bar"
                         class="progress-bar"
                         role="progressbar" style="width: 0%">0%</div>
                </div>

                <div class="row g-2 text-center mt-3">
                    <div class="col-4">
                        <div class="stat-tile">
                            <div class="num" id="stat-failed">0</div>
                            <div class="lbl">xatolik</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-tile">
                            <div class="num" id="stat-in">0</div>
                            <div class="lbl">kirish token</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-tile">
                            <div class="num" id="stat-out">0</div>
                            <div class="lbl">chiqish token</div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div id="error-box" class="alert alert-danger d-none"></div>

        <div id="done-box" class="d-none anim-in">
            <div class="alert alert-success d-flex align-items-center gap-2">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                </svg>
                <span>Tahlil yakunlandi. Natija fayli tayyor.</span>
            </div>

            <a id="download-link" class="btn btn-success btn-lg w-100 mb-4"
               asp-action="Download" asp-route-id="@Model.Id">
                <span class="d-inline-flex align-items-center gap-2 justify-content-center">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
                    </svg>
                    Natijani yuklab olish (.xlsx)
                </span>
            </a>

            <div class="card">
                <div class="card-header">Kategoriyalar taqsimoti</div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Kategoriya</th>
                                <th style="width: 34%;">Ulush</th>
                                <th class="text-end" style="width: 90px;">Soni</th>
                            </tr>
                        </thead>
                        <tbody id="summary-body"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <a asp-action="Index" class="btn btn-link mt-3 px-0">&larr; Yangi fayl yuklash</a>

    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const jobId = document.getElementById('job').dataset.jobId;
            const statusUrl = '@Url.Action("Status", "Home")/' + jobId;

            const bar = document.getElementById('bar');
            const label = document.getElementById('status-label');
            const counter = document.getElementById('counter');
            const errorBox = document.getElementById('error-box');
            const doneBox = document.getElementById('done-box');
            const summaryBody = document.getElementById('summary-body');

            const labels = {
                Pending: ['Kutilmoqda', 'bg-secondary'],
                Running: ['Bajarilmoqda', 'bg-primary'],
                Completed: ['Yakunlandi', 'bg-success'],
                Failed: ['Xatolik', 'bg-danger']
            };

            function render(data) {
                const [text, cls] = labels[data.status] || ['Noma’lum', 'bg-secondary'];
                label.textContent = text;
                label.className = 'badge ' + cls;

                bar.style.width = data.progress + '%';
                bar.textContent = data.progress + '%';
                counter.textContent = data.processedRows + ' / ' + data.totalRows + ' qator';

                document.getElementById('stat-failed').textContent = data.failedRows;
                document.getElementById('stat-in').textContent = data.inputTokens.toLocaleString();
                document.getElementById('stat-out').textContent = data.outputTokens.toLocaleString();

                if (data.status === 'Failed') {
                    bar.classList.add('bg-danger');
                    errorBox.textContent = data.error || 'Nomaʼlum xatolik yuz berdi.';
                    errorBox.classList.remove('d-none');
                    return true;
                }

                if (data.status === 'Completed') {
                    doneBox.classList.remove('d-none');

                    const items = (data.summary || []);
                    const maxPct = items.reduce((m, i) => Math.max(m, i.percent), 0) || 1;

                    summaryBody.innerHTML = '';
                    items.forEach(function (item) {
                        const tr = document.createElement('tr');

                        const name = document.createElement('td');
                        name.className = 'fw-semibold';
                        name.textContent = item.category;

                        const barCell = document.createElement('td');
                        const track = document.createElement('div');
                        track.className = 'cat-bar';
                        track.style.width = Math.max(4, (item.percent / maxPct) * 100) + '%';
                        barCell.appendChild(track);

                        const count = document.createElement('td');
                        count.className = 'text-end text-muted';
                        count.textContent = item.count + ' (' + item.percent.toFixed(1) + '%)';

                        tr.append(name, barCell, count);
                        summaryBody.appendChild(tr);
                    });
                    return true;
                }

                return false;
            }

            async function poll() {
                try {
                    const response = await fetch(statusUrl, { cache: 'no-store' });
                    if (!response.ok) throw new Error('HTTP ' + response.status);

                    if (render(await response.json())) return;   // tugadi — pollingni to'xtatamiz
                } catch (e) {
                    console.error(e);
                }
                setTimeout(poll, 2000);
            }

            poll();
        })();
    </script>
}
